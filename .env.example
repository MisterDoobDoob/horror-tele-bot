# Copy this file to .env and fill in real values:
#   cp .env.example .env
# .env is gitignored, so your secrets stay local.

TELEGRAM_BOT_TOKEN=123456789:replace-with-your-bot-token

# Passkeys are paired with replies by suffix (PASSKEY_1 -> RESPONSE_1 / FILE_1, ...).
# Add as many as you like. Each passkey needs a RESPONSE, a FILE, or both.
# Use double quotes and \n for multi-line replies.
#
# FILE_<n> can be:
#   - a URL:              https://example.com/scary.jpg
#   - a local file path:  media/scary.mp4   (relative to bot.py)
#   - a Telegram file_id from a file the bot has already sent
# When both are set, the RESPONSE is used as the file's caption.
#
# How the file is shown is detected from its extension:
#   photo     .jpg .jpeg .png .webp
#   animation .gif
#   video     .mp4 .mov .webm .mkv
#   audio     .mp3 .m4a .wav .flac
#   voice     .ogg .oga
#   document  anything else (sent as a downloadable file)
# Override with FILE_TYPE_<n>=photo|animation|video|audio|voice|document
# (needed for file_ids, which have no extension).

PASSKEY_1=example-passkey-one
RESPONSE_1="You hear footsteps behind you..."

PASSKEY_2=example-passkey-two
RESPONSE_2="The door creaks open.\nSomething is waiting inside."
FILE_2=https://example.com/creaky-door.jpg

PASSKEY_3=example-passkey-three
FILE_3=media/jumpscare.mp4

PASSKEY_4=example-passkey-four
RESPONSE_4="A crumpled diary page falls out."
FILE_4=media/diary-page.pdf

# Telegram Serverless only: local files (like media/jumpscare.mp4) are uploaded
# to this chat once by build_serverless.py to get a reusable file_id, then deleted.
# Use your own user id (send /start to the bot first; @userinfobot shows your id).
# UPLOAD_CHAT_ID=123456789

# Optional: reply when the message doesn't match any passkey.
INVALID_RESPONSE="Invalid passkey ❌"
# INVALID_FILE=media/nope.gif
